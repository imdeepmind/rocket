{
  "application": {
    "name": "Barebone API"
  },
  "data": {
    "models": {
      "notes": {
        "fields": {
          "id": {
            "type": "integer",
            "primaryKey": true,
            "autoIncrement": true
          },
          "title": {
            "type": "string",
            "nullable": false,
            "apis": ["search", "edit"],
            "query": ["eq", "sort"]
          },
          "body": {
            "type": "text",
            "nullable": true
          },
          "status": {
            "type": "enum",
            "values": ["draft", "published"],
            "nullable": false,
            "apis": ["edit", "delete"],
            "query": ["eq", "in"]
          }
        }
      }
    }
  }
}
