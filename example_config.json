{
    "application": {
        "name": "Rocket OSS",
        "logLevel": "debug",
        "dangerouslyOverrideDefaultVariant": "test",
        "rateLimit": {
            "enabled": true,
            "max": 1000,
            "timeWindow": "15m"
        }
    },
    "docs": {
        "openapi": {
            "enabled": true,
            "path": "/api/docs",
            "info": {
                "title": "Rocket OSS",
                "description": "This is the sample description",
                "version": "v1.5.0",
                "termsOfService": "https://example.com/terms",
                "contact": {
                    "name": "John Doe",
                    "url": "https://example.com",
                    "email": "email@email.com"
                },
                "license": {
                    "name": "MIT",
                    "url": "https://opensource.org/licenses/MIT"
                }
            }
        }
    },
    "infrastructure": {
        "database": {
            "engine": "sqlite",
            "connection": {
                "url": "./database.db"
            },
            "timeout": 10000
        },
        "cache": {
            "engine": "redis",
            "connection": {
                "url": "redis://localhost:6379"
            },
            "timeout": 5000
        }
    },
    "authentication": {
        "enabled": true,
        "provider": {
            "type": "up-auth",
            "config": {
                "userModel": {
                    "model": "users",
                    "idField": "id",
                    "usernameField": "email",
                    "passwordField": "password",
                    "isVerifiedField": "isActive"
                },
                "jwtSecret": "your-super-secret-key-must-be-long-enough",
                "mfaRequired": true
            }
        }
    },
    "integrations": {
        "email": {
            "provider": "dummy"
        }
    },
    "data": {
        "models": {
            "users": {
                "timestamps": true,
                "fields": {
                    "id": {
                        "type": "integer",
                        "primaryKey": true,
                        "autoIncrement": true,
                        "unique": true,
                        "nullable": false,
                        "apis": ["edit", "delete"],
                        "query": ["gte"],
                        "aggregations": ["count", "avg", "max", "min", "sum"]
                    },
                    "email": {
                        "type": "string",
                        "unique": true,
                        "nullable": false,
                        "apis": ["search", "index"],
                        "query": ["eq", "sort"],
                        "aggregations": ["count"]
                    },
                    "password": {
                        "type": "string",
                        "unique": false,
                        "nullable": false
                    },
                    "name": {
                        "type": "string",
                        "nullable": true,
                        "apis": ["search", "index"],
                        "query": ["sort"]
                    },
                    "isActive": {
                        "type": "boolean",
                        "default": true,
                        "query": ["eq"]
                    }
                },
                "indexes": {
                    "email_unique": {
                        "fields": ["email"],
                        "unique": true
                    },
                    "name_active": {
                        "fields": ["name", "isActive"],
                        "unique": false
                    }
                }
            },
            "posts": {
                "validation": {
                    "type": "object",
                    "required": ["title", "userId"],
                    "properties": {
                        "title": { "type": "string", "minLength": 5 },
                        "body": { "type": "string" },
                        "userId": { "type": "integer", "minimum": 1 }
                    }
                },
                "fields": {
                    "id": {
                        "type": "integer",
                        "primaryKey": true,
                        "autoIncrement": true,
                        "unique": true,
                        "nullable": false,
                        "apis": ["edit", "delete"]
                    },
                    "title": {
                        "type": "string",
                        "nullable": false,
                        "apis": ["search"],
                        "query": ["sort"]
                    },
                    "body": {
                        "type": "text",
                        "nullable": true
                    },
                    "userId": {
                        "type": "integer",
                        "nullable": false,
                        "query": ["eq", "in"],
                        "aggregations": ["count"]
                    },
                    "createdAt": {
                        "type": "datetime",
                        "query": ["lt", "gt", "sort"]
                    },
                    "decimalNumber": {
                        "type": "decimal",
                        "query": ["lt", "gt", "sort"],
                        "aggregations": ["count", "avg", "sum", "min", "max"]
                    }
                },
                "indexes": {
                    "user_idx": {
                        "fields": ["userId"],
                        "unique": false
                    }
                },
                "relations": {
                    "author": {
                        "type": "belongsTo",
                        "model": "users",
                        "localField": "userId",
                        "foreignField": "id",
                        "onDelete": "cascade",
                        "onUpdate": "cascade"
                    }
                }
            }
        }
    },
    "customEndpoints": {
        "getUserById": {
            "method": "POST",
            "path": "/users-by-id",
            "description": "Returns a user by ID.",
            "validation": {
                "type": "object",
                "required": ["id"],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 5
                    }
                }
            },
            "handler": {
                "type": "sql",
                "sql": "SELECT * FROM USERS WHERE id = $$id:integer$$;"
            }
        }
    },
    "apiVariants": {
        "aggregate.test.users.id.getAggregation": {
            "variants": ["admin"]
        }
    },
    "apis": {
        "aggregate.admin.users.id.getAggregation": {
            "webhooks": [
                {
                    "url": "https://example.com",
                    "data": ["query", "body", "params", "response"],
                    "triggerOnRequest": false,
                    "triggerOnResponse": true
                }
            ],
            "authorization": true,
            "tags": ["Users", "Aggregations"],
            "serverParams": [
                {
                    "type": "query",
                    "name": "operations",
                    "value": "min"
                }
            ]
        }
    }
}
