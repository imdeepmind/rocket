{
    "application": {
        "name": "Rocket OSS",
        "logLevel": "debug",
        "dangerouslyOverrideDefaultVariant": "test",
        "rateLimit": {
            "enabled": true,
            "max": 1000,
            "timeWindow": "15m"
        },
        "cors": {
            "enabled": true,
            "origins": ["https://app.example.com", "http://localhost:5173"],
            "methods": ["GET", "POST", "PATCH", "PUT", "DELETE"],
            "allowedHeaders": ["Authorization", "Content-Type"],
            "exposedHeaders": ["x-ratelimit-limit", "x-ratelimit-remaining", "x-ratelimit-reset"],
            "credentials": false,
            "maxAge": 86400,
            "routes": ["/api/*"]
        },
        "magicVariables": {
            "defaultOrg": "rocket-oss"
        }
    },
    "docs": {
        "openapi": {
            "enabled": true,
            "path": "/api/docs",
            "info": {
                "title": "Rocket OSS",
                "description": "This is the sample description",
                "version": "v1.5.0",
                "termsOfService": "https://example.com/terms",
                "contact": {
                    "name": "John Doe",
                    "url": "https://example.com",
                    "email": "email@email.com"
                },
                "license": {
                    "name": "MIT",
                    "url": "https://opensource.org/licenses/MIT"
                }
            }
        }
    },
    "infrastructure": {
        "database": {
            "engine": "sqlite",
            "connection": {
                "url": "./database.db"
            },
            "timeout": 10000
        }
    },
    "authentication": {
        "enabled": true,
        "provider": {
            "type": "up-auth",
            "config": {
                "userModel": {
                    "model": "users",
                    "idField": "id",
                    "usernameField": "email",
                    "passwordField": "password",
                    "isVerifiedField": "isActive"
                },
                "jwtSecret": "your-super-secret-key-must-be-long-enough",
                "mfaRequired": true
            }
        }
    },
    "rbac": {
        "enabled": true,
        "modelName": "users",
        "roleField": "role",
        "defaultRole": "viewer",
        "roles": {
            "admin": {
                "description": "Administrator with full system access",
                "includes": ["*"]
            },
            "lead_editor": {
                "description": "Manages editorial workflows and all editor tiers",
                "includes": ["editor:*"]
            },
            "editor:senior": {
                "description": "Senior editor with publishing rights",
                "includes": ["editor:junior", "viewer"]
            },
            "editor:junior": {
                "description": "Junior editor with drafting rights",
                "includes": ["viewer"]
            },
            "auditor": {
                "description": "Compliance auditor with read-only access",
                "includes": ["viewer"]
            },
            "viewer": {
                "description": "Read-only access to published content"
            }
        }
    },
    "integrations": {
        "email": {
            "provider": "dummy"
        }
    },
    "data": {
        "models": {
            "users": {
                "timestamps": true,
                "fields": {
                    "id": {
                        "type": "integer",
                        "primaryKey": true,
                        "autoIncrement": true,
                        "unique": true,
                        "nullable": false,
                        "apis": ["edit", "delete"],
                        "query": ["gte"],
                        "aggregations": ["count", "avg", "max", "min", "sum"]
                    },
                    "email": {
                        "type": "string",
                        "unique": true,
                        "nullable": false,
                        "apis": ["search", "index"],
                        "query": ["eq", "sort"],
                        "aggregations": ["count"]
                    },
                    "password": {
                      "type": "string",
                      "unique": false,
                      "nullable": false,
                      "secret": true
                    },
                    "name": {
                        "type": "string",
                        "nullable": true,
                        "apis": ["search", "index"],
                        "query": ["sort"]
                    },
                    "isActive": {
                        "type": "boolean",
                        "default": true,
                        "query": ["eq"]
                    },
                    "role": {
                        "type": "enum",
                        "values": [
                            "admin",
                            "lead_editor",
                            "editor:senior",
                            "editor:junior",
                            "auditor",
                            "viewer"
                        ],
                        "default": "viewer",
                        "nullable": false,
                        "query": ["eq"]
                    }
                },
                "indexes": {
                    "email_unique": {
                        "fields": ["email"],
                        "unique": true
                    },
                    "name_active": {
                        "fields": ["name", "isActive"],
                        "unique": false
                    }
                }
            },
            "posts": {
                "validation": {
                    "type": "object",
                    "required": ["title", "userId"],
                    "properties": {
                        "title": { "type": "string", "minLength": 5 },
                        "body": { "type": "string" },
                        "userId": { "type": "integer", "minimum": 1 }
                    }
                },
                "fields": {
                    "id": {
                        "type": "integer",
                        "primaryKey": true,
                        "autoIncrement": true,
                        "unique": true,
                        "nullable": false,
                        "apis": ["edit", "delete"]
                    },
                    "title": {
                        "type": "string",
                        "nullable": false,
                        "apis": ["search"],
                        "query": ["sort"]
                    },
                    "body": {
                        "type": "text",
                        "nullable": true
                    },
                    "userId": {
                        "type": "integer",
                        "nullable": false,
                        "query": ["eq", "in"],
                        "aggregations": ["count"]
                    },
                    "createdAt": {
                        "type": "datetime",
                        "query": ["lt", "gt", "sort"]
                    },
                    "decimalNumber": {
                        "type": "decimal",
                        "query": ["lt", "gt", "sort"],
                        "aggregations": ["count", "avg", "sum", "min", "max"]
                    }
                },
                "indexes": {
                    "user_idx": {
                        "fields": ["userId"],
                        "unique": false
                    }
                },
                "relations": {
                    "author": {
                        "type": "belongsTo",
                        "model": "users",
                        "localField": "userId",
                        "foreignField": "id",
                        "onDelete": "cascade",
                        "onUpdate": "cascade"
                    }
                }
            }
        }
    },
    "customEndpoints": {
        "getUserById": {
            "method": "POST",
            "path": "/users-by-id",
            "description": "Returns a user by ID.",
            "validation": {
                "type": "object",
                "required": ["id"],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 5
                    }
                }
            },
            "handler": {
                "type": "sql",
                "sql": "SELECT * FROM USERS WHERE id = [[path.id:integer]];"
            }
        },
        "searchUsersByEmail": {
            "method": "GET",
            "path": "/search-users",
            "description": "Searches users by email query parameter.",
            "handler": {
                "type": "sql",
                "sql": "SELECT * FROM users WHERE email = [[query.email:string]];"
            }
        },
        "updatePostTitle": {
            "method": "PUT",
            "path": "/posts-title",
            "description": "Updates post title by path id and body title.",
            "handler": {
                "type": "sql",
                "sql": "UPDATE posts SET title = [[body.title:string]] WHERE id = [[path.id:integer]];"
            }
        }
    },
    "apiVariants": {
        "aggregate.test.users.id.getAggregation": {
            "variants": ["admin"]
        }
    },
    "apis": {
        "aggregate.admin.users.id.getAggregation": {
            "webhooks": [
                {
                    "url": "https://example.com",
                    "data": ["query", "body", "params", "response"],
                    "triggerOnRequest": false,
                    "triggerOnResponse": true
                }
            ],
            "authorization": true,
            "roles": ["admin"],
            "tags": ["Users", "Aggregations"],
            "serverSideParams": [
                {
                    "type": "query",
                    "name": "operations",
                    "value": "min"
                },
                {
                    "type": "query",
                    "name": "orgId",
                    "value": "[[defaultOrg]]"
                }
            ]
        },
        "model.test.users.unknown.getAll": {
            "authorization": true,
            "supportedQueries": ["eq"]
        },
        "model.test.posts.unknown.insert": {
            "authorization": true,
            "roles": ["editor:*"],
            "serverSideParams": [
                {
                    "type": "body",
                    "name": "userId",
                    "value": "[[userId]]"
                }
            ]
        },
        "model.test.users.id.index": {
            "authorization": true,
            "roles": ["*"],
            "supportedQueries": ["eq", "sort"]
        },
        "custom.test.all.unknown.updatePostTitle": {
            "authorization": true,
            "roles": ["editor:senior", "admin"]
        },
        "aggregate.test.users.email.getAggregation": {
            "supportedAggregations": ["count"]
        }
    }
}
